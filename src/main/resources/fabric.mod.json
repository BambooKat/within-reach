{
	"schemaVersion": 1,
	"id": "withinreach",
	"version": "${version}",
	"name": "Within Reach",
	"description": "Browse and grab items from nearby chests, right from your inventory.",
	"authors": [
		"Bamboo_Kat"
	],
	"license": "CC0-1.0",
	"icon": "assets/withinreach/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.bambookat.withinreach.WithinReach"
		],
		"client": [
			"com.bambookat.withinreach.client.WithinReachClient"
		],
		"modmenu": [
			"com.bambookat.withinreach.client.WithinReachModMenu"
		]
	},
	"mixins": [
		"withinreach.mixins.json",
		{
			"config": "withinreach.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}